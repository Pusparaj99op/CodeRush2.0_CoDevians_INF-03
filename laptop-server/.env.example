# HTTP port this service listens on locally
PORT=8787

# Local Ollama server + model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Hard ceiling on generated tokens per request, and timeouts (ms)
OLLAMA_MAX_TOKENS=512
OLLAMA_TIMEOUT_MS=120000
OLLAMA_PROBE_TIMEOUT_MS=2000

# "upto" scheme: the cap quoted in the 402, plus the usage-based rate the
# actual charge is metered at (base + per generated token), in ALGO.
PRICE_CAP_ALGO=3.0
PRICE_BASE_ALGO=0.25
PRICE_PER_TOKEN_ALGO=0.002

# Reject prompts larger than this before they reach the GPU
MAX_INPUT_CHARS=20000

# TestNet address payments settle to (must match the website's
# FACILITATOR_PAYEE_ADDRESS)
PAYEE_ADDRESS=

# Base URL of the website backend that hosts the facilitator's
# verify/settle endpoints (Doc/specs/02-website.md). Use the live site when
# demoing through a tunnel: https://www.codevians.online
FACILITATOR_BASE_URL=http://localhost:3000
FACILITATOR_TIMEOUT_MS=15000
