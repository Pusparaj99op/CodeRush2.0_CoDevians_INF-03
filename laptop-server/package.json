{
  "name": "veldar-laptop-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-inference marketplace provider (RTX 4050) implementing the x402 provider side. See Doc/specs/03-laptop-server.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
