# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical public URL. Live origins are https://www.codevians.online
# (canonical) and https://veldar-gray.vercel.app. Preview deploys derive
# their own from VERCEL_URL automatically — see lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.codevians.online

# ---------------------------------------------------------------------------
# Algorand TestNet
# ---------------------------------------------------------------------------
# algod (defaults to a public AlgoNode endpoint, no token needed)
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
ALGOD_PORT=

# Indexer, used as the fallback when algod's pending-txn window has passed
# (lib/facilitator.ts). Without this, older confirmed txns fail to verify.
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=
INDEXER_PORT=

# Facilitator's TestNet payout address (see lib/facilitator.ts). Must match
# the laptop-server's PAYEE_ADDRESS.
FACILITATOR_PAYEE_ADDRESS=

# TestNet mnemonic (25 words) of a faucet-funded account the orchestrator
# signs provider payments with — lib/payer.ts.
#
# Leave EMPTY for keyless "simulated" settlement: the demo runs end-to-end
# with no key and no funds, and every receipt/ledger event it produces is
# flagged simulated:true. Set it to switch to real on-chain settlement.
# TestNet only — lib/payer.ts refuses to sign against a non-TestNet node.
DEMO_PAYER_MNEMONIC=

# ---------------------------------------------------------------------------
# Laptop-as-Server (Doc/specs/03-laptop-server.md)
# ---------------------------------------------------------------------------
# Base URL of the laptop provider. Point this at the ngrok/Cloudflare tunnel
# once it's live; /infer and /health are derived from it.
LAPTOP_SERVER_URL=http://localhost:8787
PROVIDER_PROBE_TIMEOUT_MS=3000
PROVIDER_CALL_TIMEOUT_MS=150000

# ---------------------------------------------------------------------------
# Firebase — client (Google + email/password sign-in, lib/firebase.ts)
# ---------------------------------------------------------------------------
# Reuses the same Firebase project as the Flutter app (project number
# 511913451189) with its own Web app registration.
#
# In the Firebase console you must also:
#   1. Authentication > Sign-in method: enable Google AND Email/Password
#   2. Authentication > Settings > Authorized domains: add
#      www.codevians.online and veldar-gray.vercel.app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD4urARWR2c7bxKFuToOEtsiKUynRMS_ZI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=com-example-veldar-1426b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=com-example-veldar-1426b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=com-example-veldar-1426b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=511913451189
NEXT_PUBLIC_FIREBASE_APP_ID=1:511913451189:web:ef81a5cfc5b64d70ca68fc

# ---------------------------------------------------------------------------
# Firebase — admin (Firestore persistence + ID token verification)
# ---------------------------------------------------------------------------
# The whole service-account JSON on one line (Firebase console > Project
# settings > Service accounts > Generate new private key).
#
# Without it the app falls back to an in-memory store and accepts UNVERIFIED
# ID tokens. That's fine locally; on Vercel it means workflows vanish between
# requests, so set it there.
FIREBASE_SERVICE_ACCOUNT_JSON=
