# Algorand TestNet node (defaults to a public AlgoNode endpoint, no token needed)
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
ALGOD_PORT=

# Facilitator's TestNet payout address (see lib/facilitator.ts)
FACILITATOR_PAYEE_ADDRESS=

# Laptop-as-Server tunnel URL once ngrok/Cloudflare Tunnel is live
# (see Doc/specs/03-laptop-server.md)
LAPTOP_SERVER_URL=http://localhost:8787
