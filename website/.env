# Algorand TestNet node (defaults to a public AlgoNode endpoint, no token needed)
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=""
ALGOD_PORT=443

# Facilitator's TestNet payout address (see lib/facilitator.ts)
FACILITATOR_PAYEE_ADDRESS=

# Laptop-as-Server tunnel URL once ngrok/Cloudflare Tunnel is live
# (see Doc/specs/03-laptop-server.md)
LAPTOP_SERVER_URL=http://localhost:8787

# Firebase Web app config for Google Sign-In (website/lib/firebase.ts).
# Reuses the same Firebase project as the Flutter app (project number
# 511913451189) but needs its own Web app registration: Firebase console
# -> Project settings -> Add app -> Web. Copy the resulting config here.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD4urARWR2c7bxKFuToOEtsiKUynRMS_ZI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=com-example-veldar-1426b.firebaseapp.com
